{
  "expo": {
    "name": "Small Business Manager",
    "slug": "small-business-manager",
    "scheme": "sbm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f9d58"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.sbm.businessmanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f9d58"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Small Business Manager to attach a receipt or product photo to a record.",
          "cameraPermission": "Allow Small Business Manager to photograph a receipt or product."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:8787"
    }
  }
}
