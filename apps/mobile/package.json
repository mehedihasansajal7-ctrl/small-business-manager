{
  "name": "@sbm/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Small Business Manager Android app (Expo + React Native): offline-first partner workspace for 2-5 partners, with the farming module and the zero-cost AI agent.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "run:android": "expo run:android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.1.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sbm/domain": "file:../../packages/domain",
    "expo": "~52.0.28",
    "expo-asset": "^57.0.19",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.3",
    "expo-crypto": "~14.0.1",
    "expo-file-system": "~18.0.7",
    "expo-image-picker": "~16.0.4",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-sqlite": "~15.0.3",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-expo": "^0.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  },
  "//": "Deliberately NOT part of the root npm workspaces: the Expo dependency tree is large and installing it must be an explicit, opt-in step. See README.md.",
  "//versioning": "Expo SDK 52 pins these versions. Refresh with `npx expo install --check` after installing."
}
