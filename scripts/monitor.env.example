# Copy this file to data/monitor.env and fill in what you use.
# data/ is gitignored, so these URLs (they contain secrets) never reach GitHub.

# 1. Dead-man's switch - "is the whole PC/server alive?"
#    Free: https://healthchecks.io  -> create a check with a 5-minute period and
#    paste its ping URL here. If the PC is switched off, the missed pings make the
#    service email you. Any URL that accepts a GET also works.
HEALTHCHECK_PING_URL=

# 2. Crash alerts - "something went wrong right now"
#    Discord: Server settings -> Integrations -> Webhooks -> Copy URL
#    Slack / Google Chat incoming webhook works too.
#    The watchdog POSTs { "text": "...", "content": "..." }.
ALERT_WEBHOOK_URL=
