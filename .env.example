# =============================================================================
# Small Business Manager - example environment file
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# All values below are PLACEHOLDERS. Local development works with zero cloud
# credentials (see MODE=local).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Runtime mode
# -----------------------------------------------------------------------------
# local   -> fully offline/local server using embedded SQLite (default, free).
# shared  -> shared cloud database + auth (requires your own free-tier account).
# NOTE: the variable is SBM_MODE, not MODE, because bundlers (Vite/Vitest) use
# MODE for their own purposes.
SBM_MODE=local

# -----------------------------------------------------------------------------
# 2. Local server (apps/api)
# -----------------------------------------------------------------------------
# Port the API listens on.
PORT=8787
# Hostname bind. Use 0.0.0.0 to allow phones on the same LAN to connect.
HOST=127.0.0.1
# Filesystem directory for the embedded database + uploaded attachments.
DATA_DIR=./data
# Optional explicit database file path (default: <DATA_DIR>/sbm.db).
DATABASE_FILE=
# Default business timezone + currency (Bangladesh defaults).
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT
DEFAULT_LOCALE=bn-BD

# Abuse protection (per client IP, per process).
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_15MIN=20
RATE_LIMIT_INVITE_PER_HOUR=30

# Session signing secret. REQUIRED in shared/production mode.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset in local mode, a random one is generated and stored in DATA_DIR/.session_secret
SESSION_SECRET=
# Session lifetime in hours.
SESSION_TTL_HOURS=720
# Set to 1 only when serving over plain HTTP on a LAN for local testing.
# Production HTTPS must leave this unset (cookies are Secure by default).
INSECURE_COOKIES=

# CORS origin allowed to call the API in shared mode (the deployed web app URL).
# Leave empty in local mode (same-origin proxy is used).
CORS_ORIGIN=

# -----------------------------------------------------------------------------
# 3. Shared cloud mode (OPTIONAL - free tier only, never paid)
# -----------------------------------------------------------------------------
# Supabase project URL + public anon key. The anon key is safe to ship to clients
# ONLY because every table is protected by Row Level Security (see
# supabase/migrations). NEVER put the service_role key in a client or in this file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Used by the API in shared mode; NEVER exposed to web/APK.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# 4. AI Agent (OPTIONAL - every provider here has a no-cost path)
# -----------------------------------------------------------------------------
# Provider selection: none | local-ollama | openai-compatible
#   none              -> deterministic rule-based insights + curated source links (offline safe)
#   local-ollama      -> a model you run yourself (Ollama). No cost, no cloud.
#   openai-compatible -> any OpenAI-compatible endpoint you have free access to.
AI_PROVIDER=none
# Base URL for the OpenAI-compatible endpoint (server-side only).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Local Ollama endpoint, e.g. http://127.0.0.1:11434
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3.1:8b
# Hard limits (safety + free-tier protection).
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=700
AI_RATE_LIMIT_PER_HOUR=30

# Web research provider: none | searxng | tavily-free | disabled
#   none     -> returns curated official Bangladesh/FAO links, clearly labelled
#   searxng  -> self-hosted free meta-search endpoint
RESEARCH_PROVIDER=none
RESEARCH_BASE_URL=
RESEARCH_API_KEY=
RESEARCH_TIMEOUT_MS=15000
RESEARCH_RATE_LIMIT_PER_HOUR=20
# How long a research result is cached per business (hours).
RESEARCH_CACHE_TTL_HOURS=168
